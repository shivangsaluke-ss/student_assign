# ==========================================
# SAMS Production Environment Configuration
# Copy this file to .env and adjust values
# ==========================================

# Set to False in production!
DEBUG=False

# Generate a unique secret key for production:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-sams-gtu-bca-sem5-minor-project-key-2026

# Comma-separated allowed hostnames or * for wildcard
ALLOWED_HOSTS=*

# Comma-separated trusted origins for CSRF protection in production
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://*.railway.app,https://*.pythonanywhere.com,http://127.0.0.1,http://localhost

# Optional: Set to True if using HTTPS / SSL
SECURE_SSL_REDIRECT=False

# ==========================================
# Database Configuration Options
# ==========================================

# Option A: Cloud Managed Database (PostgreSQL / MySQL)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Option B: Local/Dedicated MySQL Database
DB_ENGINE=django.db.backends.mysql
DB_NAME=sams_db
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Option C: If no database settings are provided, SAMS automatically falls back to SQLite (db.sqlite3)
